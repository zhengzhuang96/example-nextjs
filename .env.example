# ============================================
# Supabase Configuration (Required)
# ============================================
# Get your credentials from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# AI Provider Configuration
# ============================================
# Choose one: openai, anthropic, or google
AI_PROVIDER=openai

# Model name for the chosen provider
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Google: gemini-pro, gemini-ultra
AI_MODEL=gpt-4

# API Keys - Only need the one for your chosen provider
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# ============================================
# Optional: AI Behavior Configuration
# ============================================
# Maximum tokens for AI response (default: 2048)
AI_MAX_TOKENS=2048

# Temperature: 0.0-2.0, higher = more creative (default: 0.7)
AI_TEMPERATURE=0.7

# System message to define AI behavior
AI_SYSTEM_MESSAGE=You are a helpful AI assistant.

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
